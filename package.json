{
  "name": "rosca-blockchain",
  "version": "0.1.0",
  "private": true,
  "description": "Trustless ROSCA (committee) DApp: smart contracts, tests and scripts",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:gas": "cross-env REPORT_GAS=true hardhat test",
    "coverage": "hardhat coverage",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "demo": "hardhat run scripts/demo.js",
    "gas:baseline": "hardhat run scripts/measureGas.js",
    "seed:local": "hardhat run scripts/seedLocal.js --network localhost"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "5.0.0",
    "cross-env": "7.0.3",
    "hardhat": "2.28.6"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.0.2"
  }
}
