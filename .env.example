# Copy to .env and change only what you need. Never commit .env.
# Every value below has a working default for the local Hardhat demo, so an empty .env is fine.

# ---------- Sepolia deploy (Member A / C, optional) ----------
SEPOLIA_RPC_URL=
DEPLOYER_KEY=

# ---------- Off chain services (Member B) ----------
# Which deployments/<NETWORK>.json to use and where the chain is
NETWORK=localhost
RPC_URL=http://127.0.0.1:8545

# Indexer + API (npm run offchain)
API_HOST=127.0.0.1
API_PORT=4000
INDEXER_DB=offchain/data/indexer.sqlite
# First block to index. 0 on Hardhat; on Sepolia use the deployment block.
INDEXER_START_BLOCK=0
INDEXER_POLL_MS=2000
INDEXER_BLOCK_CHUNK=2000
INDEXER_CONFIRMATIONS=0

# IPFS terms storage. The local store always works. To also pin to a real IPFS node, run Kubo
# (ipfs daemon) and set IPFS_API_URL; set IPFS_GATEWAY_URL to read CIDs the store does not have.
IPFS_LOCAL_DIR=offchain/data/ipfs
IPFS_API_URL=
IPFS_GATEWAY_URL=
IPFS_MAX_BYTES=1048576

# Notifier: reminders turn "warning" this many seconds before a deadline
NOTIFY_REMIND_BEFORE_SEC=172800

# Keeper (npm run keeper). On Hardhat it uses unlocked account #9, so no key is needed.
# On a public network put a key here in your LOCAL .env only.
KEEPER_INTERVAL_MS=5000
KEEPER_ACCOUNT_INDEX=9
KEEPER_PRIVATE_KEY=
KEEPER_SETTLE_EARLY=true
KEEPER_CANCEL_EXPIRED=true

# ---------- Frontend ----------
# Vite reads these from frontend/.env.local (copy frontend/.env.example there).
# VITE_NETWORK=localhost
# VITE_RPC_URL=http://127.0.0.1:8545
# VITE_API_URL=http://127.0.0.1:4000
# VITE_IPFS_GATEWAYS=https://ipfs.io/ipfs/,https://dweb.link/ipfs/
